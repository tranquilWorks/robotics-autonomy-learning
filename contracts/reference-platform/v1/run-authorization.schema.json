{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-authorization.schema.json",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "authorization_id": {"$ref": "#/$defs/identifier"},
    "authorization_revision": {"const": "1.0.0"},
    "authorization_status": {"enum": ["withheld", "authorized"]},
    "configuration_hash": {"$ref": "#/$defs/sha256"},
    "configuration_id": {"$ref": "#/$defs/identifier"},
    "contract_type": {"const": "run_authorization"},
    "contract_version": {"const": "1.0.0"},
    "e_stop_test_result": {"enum": ["not_run", "passed"]},
    "expiration": {"$ref": "#/$defs/timestamp"},
    "experiment_id": {"$ref": "#/$defs/identifier"},
    "guard_state": {"enum": ["not_evaluated", "accepted"]},
    "issued_at": {"$ref": "#/$defs/timestamp"},
    "local_presence_confirmed": {"type": "boolean"},
    "maximum_energy_class": {"enum": ["none", "low_energy", "guarded"]},
    "operator": {"$ref": "#/$defs/identifier"},
    "permitted_configuration": {"$ref": "#/$defs/identifier"},
    "physical_run_authorized": {"type": "boolean"},
    "preflight_checklist_revision": {"$ref": "#/$defs/identifier"}
  },
  "required": [
    "schema_version",
    "contract_version",
    "contract_type",
    "authorization_id",
    "authorization_revision",
    "experiment_id",
    "configuration_id",
    "configuration_hash",
    "operator",
    "authorization_status",
    "physical_run_authorized",
    "local_presence_confirmed",
    "preflight_checklist_revision",
    "guard_state",
    "e_stop_test_result",
    "permitted_configuration",
    "maximum_energy_class",
    "issued_at",
    "expiration"
  ],
  "title": "Reference-platform run authorization contract v1",
  "type": "object",
  "$defs": {
    "identifier": {"pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$", "type": "string"},
    "sha256": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "timestamp": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$", "type": "string"}
  }
}
